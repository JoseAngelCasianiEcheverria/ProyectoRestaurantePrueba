name: OpenCode Agent
on:
  issue_comment:
    types: [created]

jobs:
  opencode:
    if: startsWith(github.event.comment.body, '/oc')
    runs-on: ubuntu-latest
    permissions:
      contents: write
      pull-requests: write
      issues: write
    steps:
      - name: Descargar el código
        uses: actions/checkout@v4
      
      - name: Ejecutar el Agente
        uses: anomalyco/opencode-action@main
        with:
          model: 'opencode/space-bunny-free' # Configuración para usar la IA 100% gratuita
        env:
          OPENCODE_API_KEY: ${{ secrets.OPENCODE_API_KEY }}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
